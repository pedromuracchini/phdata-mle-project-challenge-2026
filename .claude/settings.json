{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make test *)",
      "Bash(make lint typecheck test)",
      "Bash(make bench)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv tree *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run python scripts/*)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git -C * commit *)",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git pull *)",
      "Bash(git tag *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git cherry-pick *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock)",
      "Bash(uv lock *)",
      "Edit(./tests/fixtures/baseline_predictions.json)",
      "Write(./tests/fixtures/baseline_predictions.json)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(uv pip install *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./src/model/model.pkl)",
      "Write(./src/model/model.pkl)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_git.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_python.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
