# syntax=docker/dockerfile:1
# Test image: the API's locked runtime dependencies plus the `test` group (pytest, ...);
# lint and type-check tools stay out of it.
# Same base image and uv as Dockerfile; keep them in sync.

ARG PYTHON_IMAGE=python:3.10.22-slim-trixie@sha256:6ff506466f8b1e981719b468cc0023b8ef000b983cdec0eafe119d01f379e31d

FROM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv

FROM ${PYTHON_IMAGE} AS builder
COPY --from=uv /uv /bin/uv
ENV UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /app
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=.python-version,target=.python-version \
    uv sync --frozen --no-install-project --no-default-groups --group test

FROM ${PYTHON_IMAGE}

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
# The Makefile runs this image as the host user (so test-results/ is not root-owned), who
# cannot write to /app: keep coverage data in test-results/ and skip pytest's cache.
# test-results/ is world-writable for runs that do not mount it.
ENV PATH="/app/.venv/bin:$PATH" \
    COVERAGE_FILE=/app/test-results/.coverage \
    PYTEST_ADDOPTS="-p no:cacheprovider"
RUN mkdir -m 1777 /app/test-results

# Copy application code (pytest.ini puts src/ on sys.path)
COPY src ./src
COPY tests ./tests
COPY pytest.ini .

# Default command runs all tests with coverage
CMD ["pytest"]
